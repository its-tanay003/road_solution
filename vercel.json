{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "cd roadsos && npm install && npm run build",
  "outputDirectory": "roadsos/.next",
  "installCommand": "cd roadsos && npm install",
  "devCommand": "cd roadsos && npm run dev",
  "rewrites": [
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
