redPrompt = null;\n    } else {\n      console.log('User dismissed the install prompt');\n    }\n  };\n\n  return { installable, handleInstallClick };\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\New Volume (D)\\mandi\\frontend\\src\\hooks\\usePoseDetection.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":41,"column":38,"messageId":"unexpectedAny","endLine":41,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1337,1340],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1337,1340],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useRef, useState } from 'react';\n\ndeclare global {\n  interface Window {\n    // MediaPipe Pose loaded from CDN ΓÇö no official type package\n    Pose: new (opts: { locateFile: (f: string) => string }) => {\n      setOptions(opts: Record<string, unknown>): void;\n      onResults(cb: (results: unknown) => void): void;\n      send(args: { image: HTMLVideoElement }): Promise<void>;\n      close(): void;\n    };\n    Camera: new (\n      el: HTMLVideoElement,\n      opts: { onFrame: () => Promise<void>; width: number; height: number }\n    ) => { start(): Promise<void>; stop(): void };\n  }\n}\n\nexport const usePoseDetection = (videoRef: React.RefObject<HTMLVideoElement | null>) => {\n  const [pose, setPose] = useState<unknown>(null);\n  const [isReady, setIsReady] = useState(false);\n  const poseRef = useRef<InstanceType<Window['Pose']> | null>(null);\n\n  useEffect(() => {\n    if (!videoRef.current || !window.Pose) return;\n\n    const poseInstance = new window.Pose({\n      locateFile: (file: string) => {\n        return `https://cdn.jsdelivr.net/npm/@mediapipe/pose/${file}`;\n      },\n    });\n\n    poseInstance.setOptions({\n      modelComplexity: 1,\n      smoothLandmarks: true,\n      enableSegmentation: false,\n      minDetectionConfidence: 0.5,\n      minTrackingConfidence: 0.5,\n    });\n\n    poseInstance.onResults((results: any) => {\n      setPose(results);\n    });\n\n    poseRef.current = poseInstance;\n\n    const camera = new window.Camera(videoRef.current, {\n      onFrame: async () => {\n        if (videoRef.current) {\n          await poseInstance.send({ image: videoRef.current });\n        }\n      },\n      width: 640,\n      height: 480,\n    });\n\n    camera.start().then(() => setIsReady(true));\n\n    return () => {\n      camera.stop();\n      poseInstance.close();\n    };\n  }, [videoRef]);\n\n  return { pose, isReady };\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\New Volume (D)\\mandi\\frontend\\src\\hooks\\useSOSButton.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\New Volume (D)\\mandi\\frontend\\src\\hooks\\useSensors.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\New Volume (D)\\mandi\\frontend\\src\\hooks\\useSettingsPanel.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\New Volume (D)\\mandi\\frontend\\src\\hooks\\useSocket.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\New Volume (D)\\mandi\\frontend\\src\\hooks\\useSoundEffects.ts","messages":[],"s