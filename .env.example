# ============================================================
# ROADSoS — Unified Environment Configuration
# Copy this file to .env (root), frontend/.env, and backend/.env
# Fill in your real keys. NEVER commit filled .env files to git.
# ============================================================

# ── App URLs ────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
NODE_ENV=development
PORT=5000

# ── Supabase ────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://njfvhhlkthqrlesmwlwv.supabase.co
SUPABASE_ANON_KEY=sb_publishable_SXOi_ihNjq1mvfRPVD5wMg_e3uwtPuD
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.njfvhhlkthqrlesmwlwv.supabase.co:5432/postgres

# Vite prefix (frontend reads these as VITE_*)
VITE_SUPABASE_URL=https://njfvhhlkthqrlesmwlwv.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_SXOi_ihNjq1mvfRPVD5wMg_e3uwtPuD

# ── AI Services ─────────────────────────────────────────────
# Anthropic (Claude) — https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Google Gemini — https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza-your-gemini-key

# OpenRouter (multi-model gateway, optional) — https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-key

# OpenAI (GPT-4o + Whisper) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key

# ── Hybrid AI Routing (backend/src/server.ts) ───────────────
# Which AI model handles each task — 'gemini' | 'claude' | 'openai'
TRIAGE_AI=gemini
VISION_AI=gemini
VITALS_AI=gemini
IDENTITY_AI=gemini
ORCHESTRATOR_AI=gemini
FIRSTAID_AI=gemini

