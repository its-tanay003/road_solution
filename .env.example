# ROADSoS environment template
# Copy values into roadsos/.env.local for local development and into Vercel project
# environment variables for preview/production. Never commit filled secrets.

NODE_ENV=development

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-random-32-byte-secret
NEXTAUTH_SECRET=replace-with-random-32-byte-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Authorization
ADMIN_EMAILS=admin@example.com,dispatcher@example.com

# OAuth providers
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
APPLE_ID=replace-with-apple-service-id
APPLE_SECRET=replace-with-apple-client-secret

# Maps and AI services
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key
ANTHROPIC_API_KEY=replace-with-anthropic-key
OPENAI_API_KEY=replace-with-openai-key
GOOGLE_GENERATIVE_AI_API_KEY=replace-with-google-ai-key

# Emergency notification providers
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_PHONE_NUMBER=+10000000000
RESEND_API_KEY=replace-with-resend-api-key
VAPID_PUBLIC=replace-with-vapid-public-key
VAPID_PRIVATE=replace-with-vapid-private-key
NEXT_PUBLIC_VAPID_PUBLIC=replace-with-vapid-public-key
