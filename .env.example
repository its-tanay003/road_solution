# ROADSoS Environment Configuration Example
# Copy this file to .env and fill in your actual keys

# Frontend (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Backend AI Services
# Get your keys from: 
# Anthropic: https://console.anthropic.com/
# OpenRouter: https://openrouter.ai/keys
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# System Configuration
# NODE_ENV should be development for local testing
NODE_ENV=development
PORT=5000

# Metrics & Monitoring (Optional)
PROMETHEUS_PORT=9090

# Database (if applicable)
# DATABASE_URL=postgresql://user:password@localhost:5432/roadsos
